# Copied to .env by start.sh on first run (with a generated password). Never commit .env.
GRAFANA_ADMIN_PASSWORD=
# Tailnet name: https://<TS_HOSTNAME>.<tailnet>.ts.net
TS_HOSTNAME=grafana
# Optional: skips the one-time interactive Tailscale sign-in.
TS_AUTHKEY=
# Site-down alert emails (Grafana). Gmail App Password works: smtp.gmail.com:587.
ALERT_EMAIL_TO=
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
