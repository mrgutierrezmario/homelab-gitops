<?xml version="1.0" encoding="UTF-8"?>
<!-- Daily check that the off-site backups are still being made (09:30, well
     after the 03:00 backups). If the Mac is asleep at 09:30 the job runs when
     it wakes. Installed by mac/install.sh, which replaces __REPO__ and
     __HOME__. Log: __HOME__/Library/Logs/backup-age-check.log -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.mgnetwork.backup-age-check</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO__/mac/backup-age-check.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <!-- launchd jobs get a minimal PATH; rclone and curl live here. -->
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>HOME</key>
    <string>__HOME__</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>9</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/backup-age-check.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/backup-age-check.log</string>
</dict>
</plist>
