<?xml version="1.0" encoding="UTF-8"?>
<!-- Nightly at 04:00: install patch/minor Homebridge plugin updates and restart
     their bridges; hold major updates for review. If the Mac is asleep at 04:00
     the job runs when it wakes. Installed by mac/install.sh, which replaces
     __REPO__ and __HOME__. Log: __HOME__/Library/Logs/homebridge-plugin-update.log -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.mgnetwork.homebridge-plugin-update</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO__/mac/homebridge-plugin-update.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <!-- launchd jobs get a minimal PATH; node and npm live here. -->
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>HOME</key>
    <string>__HOME__</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>4</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/homebridge-plugin-update.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/homebridge-plugin-update.log</string>
</dict>
</plist>
